# Backend (Express) — copy to backend/.env and fill in. Never commit real values.
NODE_ENV=development
PORT=4000

# Supabase (server-side only; the service role key must NEVER reach the frontend)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173

# Optional AI provider (app works without these)
# AI_PROVIDER: none | anthropic | openai
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=8000
AI_DAILY_LIMIT_PER_IP=30

# Rate limiting
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
